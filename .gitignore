# This repository tracks the ENTIRE app, including generated files,
# local editor/IDE configuration and build output.
# The only exclusions kept are the ones that must never be committed:
# secrets, credentials and compiled Python bytecode.

# Credentials / secrets (never commit these)
key.properties
**/*.keystore
**/*.jks

# Python bytecode
*.pyc

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

