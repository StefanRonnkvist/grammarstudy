# Generated build output, tool caches and platform ephemeral files are NOT
# tracked. Committing them produced blobs far above GitHub's 100 MB hard limit
# (libflutter.so, flutter_windows.dll.pdb, *.dill), which made every push fail
# with a pre-receive rejection.

# Flutter / Dart tool output
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Gradle
android/.gradle/

# Platform ephemeral (generated by `flutter pub get` / `flutter build`)
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
ios/Flutter/ephemeral/

# Credentials / secrets (never commit these)
key.properties
**/*.keystore
**/*.jks

# Python bytecode
*.pyc

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

